{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "Preserve",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": false,
    "noUnusedParameters": false, "skipLibCheck": true, "noEmit": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "nexus-edge.ts"]
}
